# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=az_workbase

# JWT
JWT_SECRET=super-secret-jwt-key
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super-secret-refresh-key
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug

# ZK Device (Máy chấm công)
# - Local dev (backend chạy trên máy cùng LAN văn phòng): dùng IP LAN của máy
#   chấm công, ví dụ 192.168.110.230.
# - Production (backend chạy trên Vercel - KHÔNG nằm trong LAN văn phòng):
#   PHẢI dùng IP public của văn phòng + cổng đã port-forward trên router trỏ
#   vào máy chấm công (vd router forward cổng ngoài 18818 -> 192.168.110.230:8818),
#   không dùng được IP LAN vì Vercel không có đường vào mạng nội bộ.
ZK_DEVICE_IP=Your_ZK_Device_IP
ZK_DEVICE_PORT=Your_ZK_Device_Port
ZK_DEVICE_SERIAL=Your_ZK_Device_Serial
# ⚠️ KHÔNG đặt Comm Key/mật khẩu liên kết trên máy khác 0 - thư viện
# node-zklib v1.3.0 đang dùng trong dự án KHÔNG hỗ trợ gửi mật khẩu này,
# máy sẽ từ chối mọi kết nối nếu Comm Key khác 0. Giữ nguyên 0 trên máy.

CRON_SECRET=Your_Cron_Secret

TURNSTILE_SECRET_KEY=Your_Turnstile_Secret_Key