{
  "version": 2,
  "builds": [
    {
      "src": "src/main.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "public/**/*",
          "dist/public/**/*"
        ],
        "maxLambdaSize": "50mb",
        "bundle": true
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "src/main.ts"
    },
    {
      "src": "/(.*)",
      "dest": "src/main.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/zk-device-cron/sync-today",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/periodic-tasks-cron/auto-overdue",
      "schedule": "5 17 * * *"
    }
  ]
}