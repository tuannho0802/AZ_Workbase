# Chỉ để test Sentry FE trên máy local (Sentry chỉ bật ở bản build production).
# Copy thành `.env.production.local` (đã gitignore), điền DSN của project FE TEST,
# rồi `npm run build && npm run start`. XOÁ file này sau khi test: nó ghi đè env của
# mọi lần build production local về sau.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=local
